        "manifest": "./apps/auth-hub/manifest.json",
        "path_prefix": "/auth-hub"
      },
      {
        "slug": "pwd-zero",
        "manifest": "./apps/sso-app-1/manifest.json",
        "path_prefix": "/pwd-zero"
      },
      {
        "slug": "flux",
        "manifest": "./apps/sso-app-2/manifest.json",
        "path_prefix": "/flux"
      },
