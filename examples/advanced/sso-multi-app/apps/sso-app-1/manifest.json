{
  "schema_version": "2.0",
  "slug": "pwd-zero",
  "name": "Password Generator",
  "description": "Secure password generator and manager with SSO authentication",
  "status": "active",
  "auth": {
    "mode": "shared",
    "auth_hub_url": "http://localhost:8000",
    "roles": ["base_user", "viewer", "editor", "admin"],
    "require_role": "base_user",
    "public_routes": ["/health", "/auth/callback"],
    "csrf_protection": {
      "enabled": true,
      "exempt_routes": ["/health", "/auth/callback"],
      "token_ttl": 3600
    }
  },
  "cors": {
    "enabled": true,
    "allow_origins": ["http://localhost:8000", "http://localhost:8001", "http://localhost:8002"],
    "allow_credentials": true,
    "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": ["Content-Type", "Authorization", "X-CSRF-Token"]
  },
  "data_access": {
    "read_scopes": ["pwd-zero"],
    "write_scope": "pwd-zero"
  }
}
