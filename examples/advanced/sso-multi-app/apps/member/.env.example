# =============================================================================
# Member - Cognitive Memory Showcase - Environment Variables
# =============================================================================

# MongoDB
MDB_MONGO_URI=mongodb://admin:password@localhost:27017/?authSource=admin&directConnection=true
MDB_DB_NAME=oblivio_apps

# JWT (must match auth-hub)
MDB_JWT_SECRET=oblivio_jwt_secret_change_in_production_xyz789

# Auth Hub URL (for SSO redirect)
AUTH_HUB_URL=http://localhost:8000

# OpenAI (required for embeddings)
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (default LLM provider -- or use OPENAI_API_KEY with gpt-4o)
GEMINI_API_KEY=your-gemini-key-here

# Optional: override LLM models
# CHAT_MODEL=openai/gpt-4o
# EXTRACTION_MODEL=openai/gpt-4o-mini
