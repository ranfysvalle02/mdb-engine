{
  "schema_version": "2.0",
  "slug": "gdpr_demo",
  "name": "GDPR Compliance Demo",
  "description": "Demonstrates GDPR compliance features: data export, deletion (hard/soft), and rectification with memory service integration",
  "status": "active",
  "developer_id": "developer@example.com",
  "auth": {
    "policy": {
      "provider": "casbin",
      "required": false,
      "allow_anonymous": true,
      "authorization": {
        "model": "rbac",
        "policies_collection": "casbin_policies",
        "link_users_roles": true,
        "default_roles": ["user", "admin"]
      }
    },
    "users": {
      "enabled": true,
      "strategy": "app_users",
      "collection_name": "users",
      "session_cookie_name": "gdpr_demo_session",
      "session_ttl_seconds": 86400,
      "allow_registration": true
    }
  },
  "llm_config": {
    "enabled": true,
    "providers": {
      "chat": "openai/gpt-4o"
    }
  },
  "memory_config": {
    "enabled": true,
    "provider": "cognitive",
    "collection_name": "user_memories",
    "embedding_model": "text-embedding-3-small",
    "memory_llm_model": "openai/gpt-4o",
    "embedding_model_dims": 1536,
    "infer": true,
    "async_mode": true,
    "enable_cognitive": true,
    "max_depth": 100,
    "cognitive": {
      "enabled": true,
      "emotion": {
        "enabled": true,
        "flashbulb_threshold": 0.7
      },
      "conflict_resolution": {
        "enabled": true
      },
      "pruning": {
        "max_capacity": 50,
        "strategy": "soft_delete"
      },
      "cold_storage": {
        "enabled": true,
        "retention_days": 365
      }
    },
    "categories": {
      "enabled": true,
      "custom_categories": ["personal", "work", "health"]
    }
  }
}
