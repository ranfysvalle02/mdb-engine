# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=oauth_demo_db

# MDB-Engine secret key (used for JWT signing)
FLASK_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# OAuth session secret (used by Authlib for OIDC state/nonce)
OAUTH_SESSION_SECRET=change-me-to-another-random-string

# Google OAuth 2.0 credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth App credentials
# Create at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/oauth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
