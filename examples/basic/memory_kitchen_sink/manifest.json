{
  "schema_version": "2.0",
  "slug": "memory_kitchen_sink",
  "name": "Memory Kitchen Sink - Memory + Graph Features Demo",
  "description": "Demonstrates ALL MDB-Engine memory features using inject() plus graph/knowledge graph features - no CSFLE",
  "status": "active",

  "memory_config": {
    "enabled": true,
    "provider": "cognitive",
    "collection_name": "memories",
    "embedding_model": "text-embedding-3-small",
    "chat_model": "gpt-4o",
    "embedding_model_dims": 1536,
    "infer": false,
    "async_mode": true,
    "enable_cognitive": true,
    "max_depth": 100,

    "cognitive": {
      "enabled": true,
      "decay": {
        "enabled": true,
        "default_stability_hours": 48,
        "min_stability": 0.1,
        "use_server_side_pipeline": true
      },
      "emotion": {
        "enabled": true,
        "flashbulb_threshold": 0.7,
        "max_stability_multiplier": 100
      },
      "conflict_resolution": {
        "enabled": true,
        "similarity_threshold": 0.85
      },
      "pruning": {
        "enabled": true,
        "max_capacity": 100,
        "prune_percentage": 0.1,
        "strategy": "soft_delete"
      },
      "cold_storage": {
        "enabled": true,
        "retention_days": 365
      }
    },

    "redaction": {
      "enabled": true,
      "replacement": "[REDACTED]",
      "patterns": {
        "ssn": true,
        "credit_card": true,
        "password": true,
        "api_key": true,
        "phone": false,
        "email": false
      }
    },

    "categories": {
      "enabled": true,
      "custom_categories": ["biographical", "preferences", "work", "health", "finance", "travel", "hobbies"]
    },

    "reflection": {
      "enabled": true,
      "interval_hours": 24,
      "message_threshold": 50,
      "min_salience_to_keep": 0.3,
      "store_reflections": true
    },

    "entities": {
      "enabled": true,
      "auto_extract": true
    },

    "graph": {
      "enabled": true,
      "auto_extract": true
    }
  },

  "graph_config": {
    "enabled": true,
    "collection_name": "__kg",
    "auto_extract": true,
    "default_max_depth": 2,
    "vector_index_name": "graph_vector_index",
    "embedding_dims": 1536,
    "node_types": ["person", "interest", "event", "location", "organization", "product", "concept"]
  },

  "llm_config": {
    "enabled": true,
    "default_model": "openai/gpt-4o",
    "temperature": 0.3,
    "fallbacks": ["gpt-4o-mini"],
    "litellm_config": {
      "num_retries": 2,
      "request_timeout": 60
    }
  },

  "embedding_config": {
    "enabled": true,
    "default_embedding_model": "text-embedding-3-small",
    "max_tokens_per_chunk": 1000
  },

  "cors": {
    "enabled": true,
    "allow_origins": ["*"],
    "allow_credentials": true,
    "allow_methods": ["*"],
    "allow_headers": ["*"]
  }
}
