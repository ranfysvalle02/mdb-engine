{
  "schema_version": "2.0",
  "slug": "perfect_brain",
  "name": "Perfect Brain - Complete Cognitive Architecture Demo",
  "description": "Demonstrates the FULL Perfect Brain: all memory tiers, cognitive features, GraphRAG, prospective memory, vetoes, shared memory, reflective/predictive memory, versioning, recall policies, and brain hygiene.",
  "status": "active",

  "memory_config": {
    "enabled": true,
    "provider": "cognitive",
    "collection_name": "memories",
    "embedding_model": "text-embedding-3-large",
    "chat_model": "gpt-4o",
    "embedding_model_dims": 3072,
    "infer": false,
    "async_mode": true,
    "enable_cognitive": true,
    "max_depth": 200,

    "similarity_threshold": 0.90,
    "reinforcement_factor": 1.2,
    "merge_threshold_low": 0.70,
    "merge_threshold_high": 0.85,

    "emotion_weight": 0.15,
    "recency_weight": 0.10,
    "recency_half_life_hours": 168,
    "spreading_activation": true,
    "activation_discount": 0.5,
    "salience_gate": true,
    "salience_threshold": 0.3,

    "cognitive": {
      "enabled": true,
      "emotion": {
        "enabled": true,
        "flashbulb_threshold": 0.7,
        "max_stability_multiplier": 100
      },
      "conflict_resolution": {
        "enabled": true,
        "similarity_threshold": 0.85
      },
      "pruning": {
        "enabled": true,
        "max_capacity": 10000,
        "prune_percentage": 0.05,
        "strategy": "soft_delete"
      },
      "cold_storage": {
        "enabled": true,
        "retention_days": 730
      }
    },

    "categories": {
      "enabled": true,
      "custom_categories": [
        "biographical", "preferences", "work", "health",
        "finance", "travel", "hobbies", "relationships",
        "goals", "skills"
      ]
    },

    "memory_types": {
      "enabled": true,
      "auto_detect": true,
      "default_type": "semantic",
      "episodic_retention_days": 730,
      "working_ttl_hours": 24
    },

    "reflection": {
      "enabled": true,
      "interval_hours": 24,
      "message_threshold": 50,
      "min_salience_to_keep": 0.3,
      "store_reflections": true
    },

    "consolidation": {
      "extract_entities": true,
      "route_by_type": true,
      "link_to_graph": true
    },

    "graph": {
      "enabled": true,
      "auto_extract": true
    },

    "persona": {
      "name": "Atlas",
      "role": "Cognitive memory companion with perfect recall",
      "traits": ["precise", "empathetic", "proactive", "self-aware"],
      "expertise": ["knowledge management", "pattern recognition", "relationship mapping"],
      "communication_style": "warm but analytical"
    }
  },

  "graph_config": {
    "enabled": true,
    "collection_name": "kg",
    "auto_extract": true,
    "default_max_depth": 3,
    "vector_index_name": "graph_vector_index",
    "embedding_dims": 3072,
    "node_types": [
      "person", "organization", "location", "event",
      "interest", "concept", "product", "skill",
      "project", "goal"
    ]
  },

  "llm_config": {
    "enabled": true,
    "providers": {
      "chat": "openai/gpt-4o",
      "extraction": "openai/gpt-4o-mini"
    },
    "litellm_config": {
      "num_retries": 2,
      "request_timeout": 60
    }
  },

  "embedding_config": {
    "enabled": true,
    "default_embedding_model": "text-embedding-3-large",
    "max_tokens_per_chunk": 1000
  },

  "cors": {
    "enabled": true,
    "allow_origins": ["*"],
    "allow_credentials": true,
    "allow_methods": ["*"],
    "allow_headers": ["*"]
  }
}
