# AUTO-GENERATED BY MDB-ENGINE
# Source: Knowledge graph discovery ({{ created_at }})
# Instance count: {{ instance_count }}

datasets:
  - name: {{ dataset_name }}
    source: mdb_engine.{{ app_slug }}.{{ dataset_name }}
    primary_key: [{{ dataset_name }}_id]
{% if description %}
    description: "{{ description }}"
{% endif %}
{% if fields %}
    fields:
{% for field in fields %}
      - name: {{ field.name }}
        expression:
          dialects:
            - dialect: ANSI_SQL
              expression: {{ field.expression }}
{% if field.synonyms %}
        ai_context:
          synonyms: {{ field.synonyms | tojson }}
{% endif %}
{% endfor %}
{% endif %}
{% if synonyms %}
    ai_context:
      synonyms: {{ synonyms | tojson }}
      instance_count: {{ instance_count }}
{% if sample_names %}
      sample_names: {{ sample_names | tojson }}
{% endif %}
{% endif %}
