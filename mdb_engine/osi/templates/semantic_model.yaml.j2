# AUTO-GENERATED BY MDB-ENGINE
# Source: Knowledge graph export for app '{{ app_slug }}'
# Generated: {{ created_at }}
# Node count: {{ node_count }}
# Type count: {{ type_count }}

semantic_model:
  - name: {{ model_name }}
    description: "{{ description }}"
{% if ai_context %}
    ai_context:
{% if ai_context.description %}
      description: "{{ ai_context.description }}"
{% endif %}
{% if ai_context.community_insights %}
      community_insights:
{% for insight in ai_context.community_insights %}
        - "{{ insight }}"
{% endfor %}
{% endif %}
{% endif %}

{% if datasets %}
    datasets:
{% for dataset in datasets %}
      - name: {{ dataset.name }}
        source: {{ dataset.source }}
        primary_key: {{ dataset.primary_key | tojson }}
{% if dataset.fields %}
        fields:
{% for field in dataset.fields %}
          - name: {{ field.name }}
            expression:
              dialects:
                - dialect: ANSI_SQL
                  expression: {{ field.expression.dialects[0].expression }}
{% if field.ai_context %}
            ai_context:
              synonyms: {{ field.ai_context.synonyms | tojson }}
{% endif %}
{% endfor %}
{% endif %}
{% if dataset.ai_context %}
        ai_context:
          synonyms: {{ dataset.ai_context.synonyms | tojson }}
          instance_count: {{ dataset.ai_context.instance_count }}
{% endif %}
{% endfor %}
{% endif %}

{% if relationships %}
    relationships:
{% for rel in relationships %}
      - name: {{ rel.name }}
        from: {{ rel.from }}
        to: {{ rel.to }}
        from_columns: {{ rel.from_columns | tojson }}
        to_columns: {{ rel.to_columns | tojson }}
{% endfor %}
{% endif %}

    metrics: []

    custom_extensions:
      - vendor_name: MDB_ENGINE
        data: '{{ custom_data }}'
